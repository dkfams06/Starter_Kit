# Use a unique prefix and resource names for every customer installation.
# Enable only for a dedicated portfolio database containing no real customer data.
DEMO_MODE=false
COMPOSE_PROJECT_NAME="work-management-starter-kit"
COMPOSE_CONTAINER_NAME="work-management-starter-kit-db"
POSTGRES_VOLUME_NAME="work-management-starter-kit-postgres-data"
POSTGRES_NETWORK_NAME="work-management-starter-kit-network"
POSTGRES_PORT="5433"
POSTGRES_DB="starterkit"
POSTGRES_USER="starterkit"
POSTGRES_PASSWORD="starterkit_local_only"

# Keep this URL consistent with the PostgreSQL values above.
DATABASE_URL="postgresql://starterkit:starterkit_local_only@127.0.0.1:5433/starterkit?schema=public"

# Exact public origin for Auth.js callbacks. Change per customer/environment.
AUTH_URL="http://127.0.0.1:3002"
NEXTAUTH_URL="http://127.0.0.1:3002"

# Generate with `pnpm exec auth secret`. Never commit the generated value.
AUTH_SECRET=""
