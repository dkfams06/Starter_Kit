generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Role {
  ADMIN
  USER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  FIRST_ADMIN_CREATED
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_DEACTIVATED
  CUSTOMER_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  PRODUCT_DELETED
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CONFIRMED
  ORDER_CONFIRMATION_REVERTED
  ORDER_CANCELLED
  ORDER_DELETED
  ORDER_SHIPPED
  ORDER_EXPORTED
  DEMO_RESET
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  SHIPPED
  CANCELLED
}

model Customer {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  businessNumber String?
  contactName    String?
  phone          String?
  email          String?
  defaultAddress String?
  memo           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hasOrderHistory Boolean @default(false)
  orders CustomerOrder[]

  @@index([isActive, name])
}

model Product {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  specification    String?
  unit             String
  defaultUnitPrice Decimal? @db.Decimal(14, 2)
  memo             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  hasOrderHistory Boolean @default(false)
  orderItems OrderItem[]

  @@index([isActive, name])
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role       @default(USER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[] @relation("AuditActor")
  createdOrders CustomerOrder[] @relation("OrderCreator")
  confirmedOrders CustomerOrder[] @relation("OrderConfirmer")
  cancelledOrders CustomerOrder[] @relation("OrderCanceller")
  shipments Shipment[]

  @@index([role, isActive])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([ipAddress, action, createdAt])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

model CustomerOrder {
  id String @id @default(cuid())
  orderNo String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerCodeSnapshot String
  customerNameSnapshot String
  shippingAddress String
  status OrderStatus @default(RECEIVED)
  version Int @default(1)
  orderedAt DateTime @default(now())
  requestedShipDate DateTime? @db.Date
  totalAmount Decimal @db.Decimal(16, 2)
  memo String?
  createdById String?
  createdBy User? @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  firstConfirmedAt DateTime?
  confirmedById String?
  confirmedBy User? @relation("OrderConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt DateTime?
  cancelledById String?
  cancelledBy User? @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt DateTime?
  cancelReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  shipment Shipment?
  @@index([status, orderedAt])
  @@index([customerId, orderedAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo Int
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCodeSnapshot String
  productNameSnapshot String
  specificationSnapshot String?
  unitSnapshot String
  quantity Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)
  lineAmount Decimal @db.Decimal(16, 2)
  @@unique([orderId, lineNo])
  @@index([productId])
}

model Shipment {
  id String @id @default(cuid())
  orderId String @unique
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippedAt DateTime @default(now())
  carrier String?
  trackingNumber String?
  memo String?
  shippedById String?
  shippedBy User? @relation(fields: [shippedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model OrderNumberCounter {
  date DateTime @id @db.Date
  lastValue Int
}
